# ==============================================================================
# Dockerfile: Đóng gói Anti-Spy Detection System trên Ubuntu 22.04 LTS
# ==============================================================================
FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Ho_Chi_Minh

# 1. Cài đặt các gói công cụ và build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    wget \
    unzip \
    xz-utils \
    zip \
    clang \
    cmake \
    ninja-build \
    pkg-config \
    libgtk-3-dev \
    liblzma-dev \
    libgstreamer1.0-dev \
    libgstreamer-plugins-base1.0-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# 2. Cài đặt Flutter SDK
ENV FLUTTER_HOME=/opt/flutter
ENV PATH="${FLUTTER_HOME}/bin:${PATH}"

RUN git clone -b stable https://github.com/flutter/flutter.git ${FLUTTER_HOME} \
    && flutter config --enable-linux-desktop \
    && flutter precache --linux

# 3. Copy mã nguồn Flutter
WORKDIR /app
COPY flutter_app/ /app/

# 4. Tải packages và biên dịch ứng dụng Linux Release
RUN flutter pub get && flutter build linux --release

# ==============================================================================
# Runtime Stage (Siêu nhẹ, chỉ giữ lại runtime và binary)
# ==============================================================================
FROM ubuntu:22.04 AS runner

ENV DEBIAN_FRONTEND=noninteractive

# Cài đặt thư viện runtime cho GTK, GStreamer (Webcam)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgtk-3-0 \
    liblzma5 \
    libgstreamer1.0-0 \
    libgstreamer-plugins-base1.0-0 \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Tạo user không phải root để đảm bảo an toàn bảo mật
RUN useradd -m -s /bin/bash appuser
WORKDIR /home/appuser/antispy

# Copy bundle đã biên dịch từ builder stage
COPY --from=builder /app/build/linux/x64/release/bundle/ /home/appuser/antispy/
RUN chown -R appuser:appuser /home/appuser/antispy

USER appuser

# Lệnh khởi chạy ứng dụng
CMD ["./antispy_detector"]
